# =============================================================
#  Root .htaccess — redirects all requests into the public/ folder.
#  Needed on shared hosting (cPanel/Plesk) where the document root
#  points at the project root instead of /public. On Laragon the
#  vhost points directly at /public, so this file is harmless there.
# =============================================================

# Disable directory listing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Send everything to the public/ directory
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to sensitive files in the project root
<FilesMatch "^(\.env.*|\.git.*|composer\.(json|lock)|package\.json|.*\.log|artisan)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
